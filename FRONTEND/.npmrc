; Mirror of the root .npmrc, and it has to be a real copy rather than an
; inheritance — npm reads the project .npmrc from the CURRENT WORKING
; DIRECTORY and does not walk up to a parent. The root build script runs
; `cd FRONTEND && npm install`, so that install would otherwise fall back to
; npm's 2-retry defaults, which is the exact failure this guards against.
;
; Keep the two files in step. See the root .npmrc for the reasoning.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=600000
